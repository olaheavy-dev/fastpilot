# FastPilot frontend (production). Internet-facing: no API keys here, ever.
# No comment after a value (an env file would read it as part of the value).

# The backend's container name, not the short service name "backend": the frontend also sits on the
# shared caddy_net, where another app could one day have a service called "backend".
API_BASE_URL=http://fastpilot-prod-backend:8000
# The same value as in backend.env.
FRONTEND_PROXY_KEY=
VISITOR_IP_HEADER=CF-Connecting-IP
# The same two values as in backend.env.
AGENT_ENABLED=true
PLAYGROUND_ENABLED=true
