# FastPilot backend (production). Copy to backend.env on the operator machine, fill in, never commit.
# One KEY=value per line, no quotes, no ${...}, and no comment after a value: an env file reads
# "KEY=   # note" as the value "# note". The infra helper checks key names and value shapes and
# never prints values.

# --- Models (API keys) ---
GOOGLE_API_KEY=
VOYAGE_API_KEY=

# --- Qdrant (the fastpilot-prod-qdrant container) ---
QDRANT_URL=http://qdrant:6333
# The same value as QDRANT__SERVICE__API_KEY in qdrant.env.
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_accelerator_capstone_final

# --- Redis (the fastpilot-prod-redis container) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
# The same value as requirepass in redis.conf.
REDIS_PASSWORD=
# Plain Redis on the private network; true would fail and fall back to memory.
REDIS_SSL=false

# --- Opik (founder, 23 Nov 2026: "On, with a privacy note") ---
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=fastpilot

# --- Site ---
CORS_ORIGINS=https://fastpilot.olaheavy.dev
DEBUG=false
# Never write visitor text to a local file in production.
DOGFOOD_ENABLED=false
# The same two values in frontend.env; false in both, then rerun the helper, is the switch-off.
AGENT_ENABLED=true
PLAYGROUND_ENABLED=true

# --- Rate limits per visitor address (issue #12); none may be 0 on a site that runs visitor code ---
# openssl rand -hex 32; the same value in frontend.env.
FRONTEND_PROXY_KEY=
CHAT_RATE_PER_DAY=15
AGENT_RATE_PER_MIN=2
AGENT_RATE_PER_DAY=5
PLAYGROUND_RATE_PER_MIN=3
PLAYGROUND_RATE_PER_DAY=30
